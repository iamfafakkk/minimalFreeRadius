# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=radius
DB_USER=radius
DB_PASSWORD=radiuspass123!

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# API Configuration
API_PREFIX=/api/v1

# API Key (alternative to JWT, sent as X-API-Key header)
API_KEY=freeradius-api-key-change-this

# Rate Limiting Configuration (hanya request /api/*, file statis tidak dihitung)
# Window in milliseconds (15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window per IP
RATE_LIMIT_MAX_REQUESTS=1000

# CORS Configuration
# Use specific origins in production, e.g., https://yourdomain.com
CORS_ORIGIN=*

# Admin User Configuration
# Default admin credentials (change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123!

# App database (SQLite): admin login users, login history, activity log.
# Created and seeded automatically on every server start (idempotent);
# the admin row is only inserted once, so changing ADMIN_PASSWORD later
# does not overwrite an existing account.
APP_DB_PATH=freeradius.db

# FreeRADIUS log file tailed live by the panel (Radius Logs page).
RADIUS_LOG=/var/log/freeradius/radius.log

# Frontend (hasil `npm run build` di freeradius-web, adapter-static)
# Dibiarkan kosong = otomatis cari ./web, ../freeradius-web/build, dst.
# Kosong dan tidak ditemukan = mode API-only.
# WEB_DIR=/opt/freeradius-web

# Logging Configuration (optional)
# LOG_LEVEL=info
# LOG_FILE=logs/app.log

# SSL / HTTPS Configuration (optional)
# Enable built-in HTTPS server in addition to HTTP
# HTTPS_ENABLED=false
# HTTPS_PORT=3443
# SSL_CERT_PATH=/path/to/certificate.crt
# SSL_KEY_PATH=/path/to/private.key

# Database Pool Configuration (optional)
# DB_CONNECTION_LIMIT=10
