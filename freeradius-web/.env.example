# URL Go backend (tanpa trailing slash). Dipakai server-side saja.
BACKEND_URL=http://localhost:3000
# Harus sama dengan API_PREFIX di backend (.env freeradius-api)
API_PREFIX=/api/v1
# Port SvelteKit (npm run dev maupun node build)
PORT=5173
# WAJIB saat dijalankan via `node build` (adapter-node) di atas HTTP polos:
# isi dengan origin publik frontend, mis. http://localhost:5173 atau https://radius.example.com.
# Tanpa ini, adapter-node menganggap request sebagai https dan semua form POST
# (login) ditolak 403 oleh proteksi CSRF SvelteKit.
ORIGIN=http://localhost:5173
# Bila di belakang reverse proxy (nginx), set ini + teruskan header proto:
# PROTOCOL_HEADER=x-forwarded-proto
